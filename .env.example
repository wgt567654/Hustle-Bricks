# ─────────────────────────────────────────────────────────────────────────────
# HustleBricks environment variables
#
# Copy this file to `.env.local` and fill in the values.
#   cp .env.example .env.local
#
# The app BOOTS with only the "Core" section below. Every other section is
# optional — the related feature stays dormant until its keys are provided
# (SMS queues until Twilio is set, card payments hide until Stripe is set, etc.).
# NEXT_PUBLIC_* values are exposed to the browser; everything else is server-only.
# ─────────────────────────────────────────────────────────────────────────────


# ── Core: Supabase (REQUIRED — app will not run without these) ────────────────
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# The service_role secret key — used by server routes that bypass row-level
# security (public booking, quote links, cron). Keep this secret; never expose.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key


# ── Core: App URLs & link security (REQUIRED) ─────────────────────────────────
# The app's own base URL. Local dev = http://localhost:3000; prod = your domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Used when generating public-facing links (booking, quotes). Usually the same.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Secret for signing public quote/booking links (HMAC). Generate a random value:
#   openssl rand -hex 32
# If unset, the app falls back to CRON_SECRET.
LINK_SIGNING_SECRET=generate-a-long-random-string
# Protects the scheduled cron endpoints (daily briefings, reminders, follow-ups).
# Generate another random value the same way.
CRON_SECRET=generate-another-long-random-string
# Set to "true" to let older, token-less quote links keep working. Leave unset
# (or "false") in normal operation.
QUOTE_LINK_GRACE=false


# ── Email: Resend (OPTIONAL — owner/customer notifications) ───────────────────
# Without this, notification emails are silently skipped (SMS still queues).
# resend.com → API Keys
RESEND_API_KEY=


# ── SMS: Twilio (OPTIONAL — texts queue until all three are set) ──────────────
# Every SMS is written to the sms_queue table first; it only sends once these
# credentials exist. Requires A2P 10DLC registration for US numbers.
# twilio.com → Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=


# ── Payments: Stripe (OPTIONAL — card payments & platform billing) ────────────
# Card-pay UI stays hidden until the secret + publishable keys are present.
# stripe.com → Developers → API keys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook signing secrets — one per endpoint (Developers → Webhooks).
STRIPE_WEBHOOK_SECRET=
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
# Stripe Connect (lets each business collect from its own customers).
STRIPE_CONNECT_CLIENT_ID=
# Platform application fee in basis points (100 = 1%). Only used with Connect.
PLATFORM_FEE_BPS=0
# Subscription price IDs for the SaaS plans (Products → each price).
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_SOLO_YEARLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=


# ── Google (OPTIONAL — Maps + Calendar sync) ──────────────────────────────────
# Maps API key powers the canvassing map and address lookups.
# console.cloud.google.com → APIs & Services → Credentials
GOOGLE_MAPS_API_KEY=
# OAuth client for Google Calendar sync (outbound job → calendar events).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ── AI: Anthropic (OPTIONAL — in-app AI assistant / suggestions) ──────────────
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
